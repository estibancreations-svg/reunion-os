// Reunion OS — Supabase Postgres schema
// Local: set DATABASE_URL + DIRECT_URL in .env
// Deploy: set same env vars in Vercel project settings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String
  preferredName String?
  phone         String?
  ageTier       String    @default("ADULT_18_64")
  roleTier      String    @default("VOLUNTEER")
  avatarUrl     String?
  householdId   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  assignments   Assignment[]
  tasks         Task[]          @relation("AssignedTasks")
  notifications Notification[]
  gamification  Gamification?
  achievements  UserAchievement[]
  intakeSessions IntakeSession[]
  commsMemberships CommsChannelMember[]
  commsMessages    CommsMessage[]
  commsReads       CommsMessageRead[]
  commsPresence    CommsPresence?
}

model Category {
  id               String   @id @default(cuid())
  name             String
  description      String   @default("")
  isCustom         Boolean  @default(false)
  color            String   @default("#C84B31")
  icon             String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tasks            Task[]
  assignmentLinks  AssignmentCategory[]
}

model Assignment {
  id                       String   @id @default(cuid())
  userId                   String
  title                    String
  roleTier                 String
  specificResponsibilities String
  notes                    String?
  assignedBy               String
  assignedAt               DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id])
  categories               AssignmentCategory[]
}

model AssignmentCategory {
  assignmentId String
  categoryId   String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([assignmentId, categoryId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  status      String   @default("TODO")
  priority    String   @default("MEDIUM")
  categoryId  String?
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @default("")
  type      String   @default("info")
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Gamification {
  id        String @id @default(cuid())
  userId    String @unique
  xp        Int    @default(0)
  level     Int    @default(1)
  streak    Int    @default(0)
  user      User   @relation(fields: [userId], references: [id])
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model IntakeSession {
  id          String   @id @default(cuid())
  userId      String
  answersJson String
  status      String   @default("completed")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommsChannel {
  id            String              @id @default(cuid())
  name          String
  description   String              @default("")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  members       CommsChannelMember[]
  messages      CommsMessage[]
}

model CommsChannelMember {
  channelId     String
  userId        String
  joinedAt      DateTime    @default(now())
  channel       CommsChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
}

model CommsMessage {
  id            String              @id @default(cuid())
  channelId     String
  senderUserId  String
  type          String              @default("text")
  body          String              @default("")
  audioUrl      String?
  durationSec   Int?
  mentionsJson  String?
  createdAt     DateTime            @default(now())
  channel       CommsChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender        User                @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  reads         CommsMessageRead[]
}

model CommsMessageRead {
  messageId     String
  userId        String
  readAt        DateTime     @default(now())
  message       CommsMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model CommsPresence {
  userId       String    @id
  status       String    @default("offline")
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
