# ─── Site ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_OSIRIS_URL=https://osiris.your-domain.example

# ─── Supabase (Postgres) ────────────────────────────
# Project Settings → Database → Connection string (URI)
# Use the "Transaction" or "Session" pooler URI for serverless (Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for migrations / prisma db push from local)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API (optional — Auth / Storage later)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Enable providers in Supabase Dashboard → Authentication → Providers:
# - Google OAuth
# - Apple OAuth
# - Yahoo OAuth / OIDC (if configured in your Supabase project)
# - Email provider (magic link / OTP)
# - Phone provider (SMS OTP)

# ─── External Intelligence ──────────────────────────
# Deploy OSIRIS separately (Docker/self-hosted) and point Reunion OS at the public
# host or reverse-proxied subdomain for the admin read-only intelligence surface.

# ─── Auth (when you add Auth.js / Clerk) ─────────────
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
